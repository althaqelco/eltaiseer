rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin UID for El Taiseer Properties
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'OaxywaxcdFNn3kTJeE7MJTq9M0L2';
    }
    
    // Properties collection rules
    match /properties/{propertyId} {
      // Anyone can read properties (public listing)
      allow read: if true;
      
      // Only admin can create, update, or delete properties
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ─── بيع وشراء أراضي «بيت الوطن» (وساطة موثّقة) ───
    // الإعلان العام بلا بيانات شخصية ولا رقم القطعة. المسودة والمسحوب لا يقرأهما إلا المسؤول.
    match /bw_listings/{listingId} {
      allow read: if isAdmin() || resource.data.status in ['active', 'sold', 'expired'];
      allow write: if isAdmin();
    }

    // ملف البائع ورقم القطعة وبصمة منع التكرار: للمسؤول وحده
    match /bw_private/{listingId} {
      allow read, write: if isAdmin();
    }
    match /bw_plot_index/{plotHash} {
      allow read, write: if isAdmin();
    }

    // عدادات الطلب المعلنة (تُعرض من 3 طلبات فأكثر) يحسبها المسؤول من لوحة التحكم
    match /bw_demand/{citySlug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // طلبات البيع والشراء من الزوار: إنشاء فقط بحقول وأطوال محددة، والقراءة للمسؤول
    function validBwRequest(d) {
      return d.keys().hasOnly(['kind', 'name', 'phone', 'citySlug', 'district', 'phase', 'area', 'budgetEgp', 'notes', 'consent', 'status', 'createdAt'])
        && d.keys().hasAll(['kind', 'name', 'phone', 'citySlug', 'district', 'phase', 'area', 'budgetEgp', 'notes', 'consent', 'status', 'createdAt'])
        && d.kind in ['buy', 'sell']
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.phone is string && d.phone.matches('^[+]?[0-9]{8,19}$')
        && d.citySlug is string && d.citySlug.matches('^[a-z0-9-]{2,40}$')
        && d.district is string && d.district.size() <= 80
        && d.phase in ['old', '11', 'any']
        && (d.area == null || (d.area is int && d.area > 0 && d.area <= 100000))
        && (d.budgetEgp == null || (d.budgetEgp is int && d.budgetEgp > 0 && d.budgetEgp <= 10000000000))
        && d.notes is string && d.notes.size() <= 500
        && d.consent == true
        && d.status == 'new'
        && d.createdAt == request.time;
    }
    match /bw_requests/{requestId} {
      allow create: if validBwRequest(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
